{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./out-tsc/spec",
        "types": ["vitest/globals", "node"]
    },
    "angularCompilerOptions": {
        /* The base config is a library config: it emits a flat module in partial
           compilation mode. Tests are built as an application, so both must be off. */
        "flatModuleOutFile": null,
        "flatModuleId": null,
        "compilationMode": "full"
    },
    /* The base config excludes *.spec.ts (they must never ship in the package);
       for the test build they are the entry points. */
    "include": ["src/**/*.spec.ts", "src/**/*.d.ts", "src/test-setup.ts"],
    "exclude": ["node_modules"]
}
