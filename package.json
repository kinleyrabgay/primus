{
    "name": "@selisedev/primus-beta",
    "version": "0.0.2",
    "author": "SELISE",
    "description": "Angular UI component library (beta). shadcn-style, source-first fork of PrimeNG 21.1.9 (MIT) on Angular 22, with the PrimeUIX theming engine vendored in-tree. Beta channel for @selisedev/primus.",
    "license": "MIT",
    "private": true,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:package": "pnpm run build:prebuild && ng build primus && pnpm run build:postbuild",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "build:postbuild": "node ./scripts/postbuild.mjs",
        "pack:prep": "node ./scripts/pack-prep.mjs",
        "release:beta": "pnpm run build && pnpm run pack:prep && npm publish ./dist",
        "clean": "npx rimraf --glob node_modules dist .angular ./pnpm-lock.yaml",
        "lint": "ng lint",
        "test": "pnpm run test:unit",
        "test:unit": "ng test primus --watch=false",
        "test:unit:watch": "ng test primus",
        "test:unit:coverage": "ng test primus --coverage",
        "format": "prettier --write \"src/**/*.{js,mjs,ts,mts,d.ts,html}\" --cache",
        "format:check": "prettier --check \"src/**/*.{js,mjs,ts,mts,d.ts,html}\""
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "catalog:angular22",
        "@angular-eslint/eslint-plugin": "catalog:angular22",
        "@angular-eslint/eslint-plugin-template": "catalog:angular22",
        "@angular-eslint/schematics": "catalog:angular22",
        "@angular-eslint/template-parser": "catalog:angular22",
        "@angular/animations": "catalog:angular22",
        "@angular/build": "catalog:angular22",
        "@angular/cli": "catalog:angular22",
        "@angular/compiler": "catalog:angular22",
        "@angular/compiler-cli": "catalog:angular22",
        "@angular/platform-browser-dynamic": "catalog:angular22",
        "@angular/platform-server": "catalog:angular22",
        "@typescript-eslint/eslint-plugin": "^8.13.0",
        "chart.js": "^4.4.0",
        "cross-env": "^7.0.3",
        "eslint": "^9.14.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jsdoc": "^50.4.3",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-prettier": "^4.2.1",
        "fs-extra": "^11.2.0",
        "glob": "^10.4.2",
        "jiti": "^2.4.2",
        "jsdom": "^28.0.0",
        "ng-packagr": "catalog:angular22",
        "prettier": "^3.0.0",
        "quill": "^2.0.0",
        "tslib": "^2.8.1",
        "typescript": "catalog:angular22",
        "vitest": "^4.0.8"
    },
    "peerDependencies": {
        "@angular/cdk": "catalog:angular22",
        "@angular/common": "catalog:angular22",
        "@angular/core": "catalog:angular22",
        "@angular/forms": "catalog:angular22",
        "@angular/platform-browser": "catalog:angular22",
        "@angular/router": "catalog:angular22",
        "rxjs": "^6.0.0 || ^7.8.1"
    },
    "packageManager": "pnpm@9.6.0",
    "lint-staged": {
        "src/**/*.{js,mjs,ts,mts,d.ts,html}": [
            "prettier --write"
        ]
    },
    "homepage": "https://github.com/kinleyrabgay/primus#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kinleyrabgay/primus.git"
    },
    "bugs": {
        "url": "https://github.com/kinleyrabgay/primus/issues"
    },
    "keywords": [
        "angular",
        "angular-components",
        "ui",
        "component-library",
        "primeng",
        "primeng-fork",
        "design-system",
        "shadcn",
        "tailwind",
        "primus"
    ],
    "bin": {
        "primus": "./cli/primus.mjs"
    }
}
